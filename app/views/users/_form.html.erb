<%= form_with(model: @user, class: "space-y-6") do |f| %>
  <%= render 'shared/error_messages', object: @user %>
  
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.text_field :name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors", placeholder: "Enter your name" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.email_field :email, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors", placeholder: "you@example.com" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.password_field :password, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors", placeholder: "Min. 6 characters" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirmation", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.password_field :password_confirmation, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors", placeholder: "Confirm password" %>
  </div>

  <div class="pt-4">
    <%= f.submit yield(:button_text), class: "w-full bg-indigo-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors cursor-pointer" %>
  </div>
<% end %>